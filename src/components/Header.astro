---
// Starlight Header 대체: 사이트 제목 옆에 About / Notes / CV 메뉴를 항상 보여 준다.
import config from 'virtual:starlight/user-config';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const path = Astro.url.pathname;

// 검색창은 노트 페이지에서만 보여 준다
const shouldRenderSearch =
	path.startsWith('/notes/') &&
	(config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro');
const nav = [
	{ label: 'About', href: '/', current: path === '/' },
	{ label: 'Notes', href: '/notes/', current: path.startsWith('/notes/') },
	{ label: 'CV', href: '/cv.pdf', current: false },
];
---

<div class="header">
	<div class="title-wrapper sl-flex"><SiteTitle /></div>
	<nav class="site-nav print:hidden" aria-label="Site">
		{
			nav.map((item) => (
				<a href={item.href} aria-current={item.current ? 'page' : undefined}>
					{item.label}
				</a>
			))
		}
	</nav>
	<div class="spacer"></div>
	<div class="sl-flex print:hidden">{shouldRenderSearch && <Search />}</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons"><SocialIcons /></div>
		<ThemeSelect />
	</div>
</div>

<style>
	.header {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		height: 100%;
	}

	.title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		flex-shrink: 0;
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.site-nav a {
		flex-shrink: 0;
		white-space: nowrap;
		display: inline-flex;
		align-items: center;
		min-height: 2.25rem;
		padding: 0 0.875rem;
		border-radius: 9999px;
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		transition: background-color 0.15s, color 0.15s;
	}

	.site-nav a:hover {
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
	}

	.site-nav a[aria-current='page'] {
		color: var(--sl-color-text-invert);
		background: var(--sl-color-white);
	}

	.spacer {
		flex: 1;
	}

	.right-group,
	.social-icons {
		gap: 1rem;
		align-items: center;
	}

	.social-icons::after {
		content: '';
		height: 2rem;
		border-inline-end: 1px solid var(--sl-color-gray-5);
	}

	/* 휴대폰: 메뉴를 조금 좁게, 오른쪽 메뉴 버튼 자리를 비워 둔다 */
	@media (max-width: 50rem) {
		.header {
			gap: 0.5rem;
		}

		.site-nav {
			gap: 0;
		}

		.site-nav a {
			padding: 0 0.5rem;
			font-size: 0.875rem;
		}

		.title-wrapper :global(.site-title) {
			font-size: 1.125rem;
		}

		:global(:root[data-has-sidebar]) .header {
			padding-inline-end: 2.75rem;
		}
	}
</style>
